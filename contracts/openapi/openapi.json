  "components": {
    "schemas": {
      "AcceptedRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "case_id": {
            "type": "string",
            "format": "uuid",
            "title": "Case Id"
          },
          "user_message_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Message Id"
          },
          "case_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Case Version"
          },
          "status": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "case_id",
          "user_message_id",
          "case_version",
          "status",
          "trace_id"
        ],
        "title": "AcceptedRequest"
      },
      "CandidateSource": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          },
          "page_from": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page From"
          },
          "page_to": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page To"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "title",
          "source_type"
        ],
        "title": "CandidateSource"
      },
      "Case": {
        "properties": {
          "case_id": {
            "type": "string",
            "format": "uuid",
            "title": "Case Id"
          },
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "case_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Case Version"
          },
          "active_request_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Request Id"
          },
          "clarification_count": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Clarification Count"
          },
          "confirmed_facts": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Confirmed Facts"
          },
          "topic_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic Id"
          },
          "subtopic_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subtopic Id"
          },
          "route": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RoutingResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo",
            "default": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "session_id",
          "status",
          "case_version",
          "clarification_count",
          "created_at",
          "updated_at"
        ],
        "title": "Case"
      },
      "CaseStatus": {
        "type": "string",
        "enum": [
          "open",
          "awaiting_clarification",
          "awaiting_feedback",
          "handoff_offered",
          "handed_off",
          "resolved",
          "closed_policy"
        ],
        "title": "CaseStatus"
      },
      "CaseView": {
        "properties": {
          "case": {
            "$ref": "#/components/schemas/Case"
          },
          "ticket": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ticket"
              },
              {
                "type": "null"
              }
            ]
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "title": "Messages"
          },
          "limit_reached": {
            "type": "boolean",
            "title": "Limit Reached",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case"
        ],
        "title": "CaseView"
      },
      "ChatInput": {
        "properties": {
          "case_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "expected_case_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Case Version"
          },
          "request_key": {
            "type": "string",
            "format": "uuid",
            "title": "Request Key"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "retry_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Of"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_key"
        ],
        "title": "ChatInput"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "current_case_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Case Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "trace_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope"
      },
      "FeedbackInput": {
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "useful": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Useful"
          },
          "solved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Solved"
          },
          "specialist_rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialist Rating"
          },
          "reason_codes": {
            "items": {
              "$ref": "#/components/schemas/FeedbackReason"
            },
            "type": "array",
            "maxItems": 2,
            "title": "Reason Codes"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message_id"
        ],
        "title": "FeedbackInput"
      },
      "FeedbackReason": {
        "type": "string",
        "enum": [
          "NOT_RELEVANT",
          "UNCLEAR",
          "MISSING_INFORMATION",
          "POSSIBLY_OUTDATED"
        ],
        "title": "FeedbackReason"
      },
      "FeedbackResponse": {
        "properties": {
          "feedback_id": {
            "type": "string",
            "format": "uuid",
            "title": "Feedback Id"
          },
          "message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Message Id"
          },
          "case_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Case Version"
          },
          "case_status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "outcome_applied": {
            "type": "boolean",
            "title": "Outcome Applied"
          },
          "outcome_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feedback_id",
          "message_id",
          "case_version",
          "case_status",
          "outcome_applied"
        ],
        "title": "FeedbackResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffInput": {
        "properties": {
          "request_key": {
            "type": "string",
            "format": "uuid",
            "title": "Request Key"
          },
          "expected_case_version": {
            "type": "integer",
            "minimum": 0.0,
