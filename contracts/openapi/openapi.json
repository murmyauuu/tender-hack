            "title": "Status"
          },
          "ready": {
            "type": "boolean",
            "title": "Ready"
          },
          "storage": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Storage"
          },
          "knowledge": {
            "type": "string",
            "enum": [
              "ready",
              "lexical_only",
              "unavailable"
